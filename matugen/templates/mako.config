font=Inter Black 13
background-color={{colors.surface_container_lowest.dark.hex}}8F
text-color={{colors.on_surface.dark.hex}}
width=340
height=110
padding=14,16
border-size=0
border-color={{colors.primary.dark.hex}}
border-radius=18
progress-color={{colors.primary.dark.hex}}
icons=1
max-icon-size=44
icon-border-radius=12
markup=1
actions=1

anchor=top-right
margin=16,16
layer=overlay

default-timeout=5000
max-visible=5
history=1
max-history=100
group-by=app-name
sort=-priority

format=<b>%s</b>\n%b

[urgency=critical]
background-color={{colors.error_container.dark.hex}}
border-color={{colors.error.dark.hex}}
default-timeout=0

[mode=do-not-disturb]
invisible=1
