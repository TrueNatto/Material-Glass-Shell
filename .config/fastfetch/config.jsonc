{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "~/.config/fastfetch/logo.png",
    "width": 30,
    "height": 15
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[92m┌───────────────────────Ricing───────────────────────┐"
    },
    {
      "type": "wm",
      "key": "\u001b[90m│ \u001b[32m  WM/DE     \u001b[90m│",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "key": "\u001b[90m│ \u001b[32m├ Greeter 󰙊  \u001b[90m│",
      "format": "TTY (Teletypewriter)"
    },
    {
      "type": "cursor",
      "key": "\u001b[90m│ \u001b[32m├ Cursor 󰇀   \u001b[90m│",
      "keyColor": "green"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[90m│ \u001b[32m├ Font      \u001b[90m│",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "\u001b[90m│ \u001b[32m└ Uptime 󱑆   \u001b[90m│",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[92m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[94m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": "\u001b[90m│ \u001b[34m  OS     \u001b[90m│",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "\u001b[90m│ \u001b[34m├ Kernel \u001b[90m│",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "\u001b[90m│ \u001b[34m├ Pkg    \u001b[90m│",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "\u001b[90m│ \u001b[34m├ Shell  \u001b[90m│",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "\u001b[90m│ \u001b[34m└ Term   \u001b[90m│",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[94m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
